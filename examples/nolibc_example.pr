import io;
import util;

fn main(ref init: InitInfo) : ExitStatus {
    io::print("Passed Arguments\n");

    var i = 0;
    var args = init.args;
    while i < args.count {
        var line: StringRef = args[i];
        io::print(line);
        io::print("\n");
        i += 1;
    }

    return ExitStatus::Success;
}