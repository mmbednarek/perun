import io;

enum Weekday {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,
}

const weekday_strings: rawptr[7] = {
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
};

fn print_weekday(wd: Weekday) {
    io::print(weekday_strings[wd]);
}

fn main() : i32 {
    var value = Weekday::Thursday;
    print_weekday(value);

    io::print("\n");

    match value {
        Monday { io::print("It's monday\n"); }
        Friday { io::print("It's friday\n"); }
        * { io::print("It's neither\n"); }
    }

    return 0;
}