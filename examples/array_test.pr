import io;

union Example {
    int_val: i32,
    float_val: f32,
}

fn main() : i32 {
    var ex = Example::int_val(16);

    match ex {
        int_val(value) {
            io::print("Int value!\n");
        }
        float_val(value) {
            io::print("Float value!\n");
        }
    }

    return 0;
}
