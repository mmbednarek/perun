import io;

enum Weekday {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,
}

const weekday_strings: rawptr[7] = {
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
};

fn print_weekday(wd: Weekday) {
    io::print(weekday_strings[wd]);
}

fn main() : i32 {
    var value = Weekday::Friday;
    print_weekday(value);
    return 0;
}