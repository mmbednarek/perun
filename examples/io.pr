import casting;

extern fn write(fd: i32, buff: rawptr, count: i64): i64;
extern fn free(ptr: rawptr);
extern fn fsync(fd: i32): i32;
extern fn strlen(str: rawptr): i64;

pub fn print(msg: StringRef) {
  write(1, msg.data, msg.size);
  fsync(1);
}

pub fn print_int(in_value: i32) {
  var str = casting::int_to_string(in_value);
  print(str);
  free(str);
}
