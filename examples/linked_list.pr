import io;
import mem;

struct LLNode {
    value: i32,
    next: *LLNode,
}

struct LinkedList {
    head: *LLNode,
    count: i32,
}

fn LinkedList.init(ref self) {
    self.head = null;
    self.count = 0;
}

fn LinkedList.add_item(ref self, value: i32) {
    var node = &self.head;
    while *node != null {
        ref node_ref = **node;
        node = &node_ref.next;
    }

    *node = mem::allocate(16);
    ref added_node: LLNode = **node;
    added_node.value = value;
    added_node.next = null;

    self.count = self.count + 1;
}

fn LinkedList.add_item_at(ref self, target_index: i32, value: i32) {
    var node = &self.head;
    var index = 0;
    while *node != null && index < target_index {
        ref node_ref: LLNode = **node;
        node = &node_ref.next;
        index = index + 1;
    }

    var old_node: rawptr = *node;

    *node = mem::allocate(16);
    ref added_node: LLNode = **node;
    added_node.value = value;
    added_node.next = old_node;

    self.count = self.count + 1;
}

fn LinkedList.remove_item(ref self, target_index: i32) {
    var index = 0;
    var node: **LLNode = &self.head;
    while *node != null && index < target_index {
        ref node_ref: LLNode = **node;
        node = &node_ref.next;
        index = index + 1;
    }

    var old_node: rawptr = *node;

    ref prev_node: LLNode = **node;
    *node = prev_node.next;

    if old_node != null {
        mem::release(old_node);
    }

    self.count = self.count - 1;
}

fn LinkedList.get_item(ref self, target_index: i32) : i32 {
    var index = 0;
    var node = self.head;
    while node != null && index < target_index {
        ref node_ref: LLNode = *node;
        node = node_ref.next;
        index = index + 1;
    }

    if node == null {
        return 0;
    }

    ref target_node: LLNode = *node;
    return target_node.value;
}

fn LinkedList.print_items(ref self) {
    var index = 0;
    while index < self.count {
        var value = self.get_item(index);
        io::print_int(index);
        io::print(". ");
        io::print_int(value);
        io::print("\n");

        index = index + 1;
    }
}

fn LinkedList.dispose(ref self) {
    var index = self.count - 1;
    while index >= 0 {
        self.remove_item(index);
        index = index - 1;
    }
}

fn main() : i32 {
    var linked_list: LinkedList;
    linked_list.init();

    // Add Items
    linked_list.add_item(2);
    linked_list.add_item(3);
    linked_list.add_item(5);
    linked_list.add_item(8);

    io::print("Items\n");
    linked_list.print_items();

    linked_list.remove_item(2);

    io::print("Removed 2nd element\n");
    linked_list.print_items();

    linked_list.add_item(10);

    io::print("Added element at end\n");
    linked_list.print_items();

    linked_list.add_item_at(1, 6);

    io::print("Added element at index 1\n");
    linked_list.print_items();

    linked_list.dispose();

    io::print("Item count after disposal: ");
    io::print_int(linked_list.count);
    io::print("\n");

    return 0;
}
