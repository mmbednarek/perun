module perunlib;

import posix;

extern fn main(ref info: InitInfo) : ExitStatus;

// This is called by _start
pub fn init_library!"perun_init_library"(argc: i32, argv: rawptr)
{
    var info: InitInfo;
    info.arg_count = argc;
    info.args = argv;

    var exit_status: i32 = main(info);
    posix::exit(exit_status);
}
